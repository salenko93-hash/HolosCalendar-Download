<resources>
    <style name="Body"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/ink</item><item name="android:textSize">16sp</item></style>
    <style name="Caption" parent="Body"><item name="android:textColor">@color/muted</item><item name="android:textSize">14sp</item><item name="android:lineSpacingExtra">4dp</item></style>
    <style name="Step" parent="Body"><item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:letterSpacing">0.07</item><item name="android:layout_marginBottom">16dp</item></style>
    <style name="FormButton"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">56dp</item><item name="android:layout_marginTop">12dp</item><item name="android:padding">16dp</item><item name="android:textSize">16sp</item><item name="android:textAllCaps">false</item><item name="android:textColor">@color/ink</item><item name="android:background">@drawable/button_secondary</item></style>
    <style name="PrimaryButton" parent="FormButton"><item name="android:background">@drawable/button_primary</item><item name="android:textColor">#FFFFFF</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Field"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">56dp</item><item name="android:padding">12dp</item><item name="android:textSize">18sp</item><item name="android:textColor">@color/ink</item><item name="android:textColorHint">@color/muted</item><item name="android:inputType">textCapSentences|textMultiLine</item></style>
</resources>
